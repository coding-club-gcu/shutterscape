m-0 inset-x-0 z-30 flex items-center gap-2.5 pointer-events-none\"><div class=\"w-7 h-7 rounded-full bg-white text-[#050505] font-sans font-bold text-[9px] flex items-center justify-center shadow-md shrink-0\">MF</div><span class=\"font-sans font-semibold text-xs text-white drop-shadow-md truncate\">Magic of Filmmaking</span></div><div class=\"absolute bottom-0 left-0 right-0 h-[3px] bg-white/20 z-30 pointer-events-none overflow-hidden\"><div class=\"h-full bg-[#EF4444] shadow-[0_0_8px_rgba(239,68,68,0.85)]\" style=\"width:0%;transition:width 0.12s linear\"></div></div></div></div><div style=\"padding-bottom:24px;padding-top:8px\" class=\"text-center\"><p class=\"font-sans text-xs text-white/45 font-medium tracking-wide\">Click active reel to toggle sound · Click side reels to navigate</p></div><div class=\"w-full\"><button type=\"button\" style=\"max-width:1320px;margin:0 auto 36px;border-radius:12px\" class=\"osl-bar-btn bg-[#D92B2B] hover:bg-[#B91C1C] text-white border border-white/15 shadow-lg\"><span>REGISTER YOUR INTEREST // JOIN SHUTTERSCAPE</span><span class=\"text-lg leading-none\">+</span></button></div></section><footer id=\"desktop-global-footer\" style=\"padding:36px 36px 96px 36px;background-color:#FAF9F5;color:#0A0A0C\" class=\"relative z-20 w-full border-t border-black/10 select-none overflow-hidden\"><div aria-hidden=\"true\" style=\"max-width:1320px;margin:0 auto\" class=\"pointer-events-none absolute inset-x-6 bottom-12 flex items-center justify-center overflow-hidden select-none\"><svg viewBox=\"0 0 620 64\" class=\"w-full h-auto overflow-visible\" preserveAspectRatio=\"xMidYMid meet\"><text x=\"50%\" y=\"52\" text-anchor=\"middle\" fill=\"rgba(10, 10, 12, 0.04)\" style=\"font-family:var(--font-sora), system-ui, sans-serif;font-weight:900;font-size:62px;letter-spacing:0.02em\">SHUTTERSCAPE</text></svg></div><div style=\"max-width:1320px;margin:0 auto\" class=\"relative z-10 w-full flex flex-col gap-5\"><div class=\"grid grid-cols-12 gap-8 items-center pb-4 border-b border-black/[0.08]\"><div class=\"col-span-7\" style=\"display:flex;flex-direction:column;gap:16px\"><div class=\"flex items-center justify-between gap-4\"><div class=\"flex items-center gap-3.5\"><div style=\"width:96px;height:26px\" class=\"relative shrink-0\"><img alt=\"ShutterScape\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain object-left\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/shutterscape-logo-cropped.png\"/></div><span class=\"h-4 w-[1px] bg-black/15 shrink-0\"></span><a href=\"https://gcu.ac.in\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Girijananda Chowdhury University\" style=\"width:105px;height:26px\" class=\"relative opacity-90 hover:opacity-100 transition-opacity shrink-0\"><img alt=\"GCU\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain object-left\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/gcu-logo-black-text.png\"/></a></div><div class=\"flex items-center gap-2.5 shrink-0\"><a href=\"https://www.instagram.com/shutterscape_gcu\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"padding:7px 14px\" class=\"rounded-full bg-black/[0.05] hover:bg-[#111111] text-[#111111] hover:text-white font-sans text-xs font-semibold tracking-tight flex items-center gap-2 transition-colors whitespace-nowrap\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"5\" ry=\"5\"></rect><path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path><line x1=\"17.5\" x2=\"17.51\" y1=\"6.5\" y2=\"6.5\"></line></svg><span>Instagram</span><span class=\"text-[10px] opacity-60\">↗</span></a><a href=\"https://chat.whatsapp.com/Hs71BicR1Xj3PmOyPJ5wdc?s=sw&amp;p=a&amp;mlu=4&amp;ilr=4\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"padding:7px 14px\" class=\"rounded-full bg-[#111111] hover:bg-[#25D366] text-white hover:text-[#050505] font-sans text-xs font-semibold tracking-tight flex items-center gap-2 transition-colors whitespace-nowrap\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21\"></path><path d=\"M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1\"></path></svg><span>WhatsApp</span><span class=\"text-[10px] text-[#FFE066]\">↗</span></a></div></div><p class=\"font-serif italic text-sm text-black/65 leading-relaxed max-w-xl\">Official visual arts &amp; photography collective of Girijananda Chowdhury University, Assam. Documenting time, culture, and stories through light.</p><div class=\"flex flex-wrap items-center gap-6 font-sans text-xs text-black/75 pt-1\"><a href=\"mailto:shutterscape@gcuniversity.ac.in\" class=\"flex items-center gap-2 hover:text-black transition-colors font-medium\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-black/45 shrink-0\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"></path></svg><span>shutterscape@gcuniversity.ac.in</span></a><a href=\"https://maps.app.goo.gl/NhdHs1u76Bjxo2J87\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"flex items-center gap-1.5 text-black/70 hover:text-black font-medium transition-colors\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"text-[#D92B2B] shrink-0\"><path d=\"M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg><span>GCU Campus, Hathkhowapara, Azara, Guwahati</span><span class=\"text-[10px] opacity-50\">↗</span></a></div></div><div class=\"col-span-5\"><div style=\"padding:8px\" class=\"rounded-2xl bg-white border border-black/12 shadow-sm overflow-hidden\"><div class=\"relative w-full h-[125px] rounded-xl overflow-hidden bg-[#ECEBE6]\"><iframe title=\"Girijananda Chowdhury University Campus Map\" src=\"https://www.google.com/maps?q=Girijananda+Chowdhury+University+Azara+Guwahati&amp;output=embed\" class=\"w-full h-full border-0 filter contrast-[1.04]\" loading=\"lazy\" referrerPolicy=\"no-referrer-when-downgrade\"></iframe><a href=\"https://maps.app.goo.gl/NhdHs1u76Bjxo2J87\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"padding:4px 10px\" class=\"absolute bottom-2 right-2 rounded-full bg-[#111111]/90 hover:bg-[#D92B2B] text-white font-mono text-[8px] font-bold uppercase tracking-wider backdrop-blur-xs shadow-md transition-colors\">OPEN IN GOOGLE MAPS ↗</a></div></div></div></div><div class=\"w-full flex items-center justify-between gap-4 font-sans text-xs text-black/50\"><span class=\"font-mono text-[9.5px] tracking-[0.12em] uppercase whitespace-nowrap\">© 2026 SHUTTERSCAPE · GIRIJANANDA CHOWDHURY UNIVERSITY</span><div class=\"flex items-center gap-1.5 text-xs text-black/65 whitespace-nowrap\"><span>Developed by<!-- --> </span><a href=\"https://codingclub.gcuniversity.ac.in\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-[#111111] hover:underline\">Codénix (GCU)</a></div></div></div></footer></div></div><div class=\"block lg:hidden\"><div id=\"shutterscape-mobile-oilstain\" class=\"w-full min-h-screen bg-[#ECEBE6] text-[#111111] font-sans select-none overflow-x-clip\"><style>\n        @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Nothing+You+Could+Do&family=Reenie+Beanie&display=swap');\n\n        #shutterscape-mobile-oilstain .font-script {\n          font-family: 'Dancing Script', cursive !important;\n        }\n\n        #shutterscape-mobile-oilstain .sound-wave {\n          display: flex;\n          align-items: center;\n          gap: 2.5px;\n          height: 12px;\n        }\n        #shutterscape-mobile-oilstain .sound-wave span {\n          display: block;\n          width: 2px;\n          background: #EF4444;\n          border-radius: 2px;\n          animation: wave 1s ease-in-out infinite;\n        }\n        #shutterscape-mobile-oilstain .sound-wave span:nth-child(1) { animation-delay: 0.1s; height: 40%; }\n        #shutterscape-mobile-oilstain .sound-wave span:nth-child(2) { animation-delay: 0.25s; height: 100%; }\n        #shutterscape-mobile-oilstain .sound-wave span:nth-child(3) { animation-delay: 0.4s; height: 60%; }\n        @keyframes wave { 50% { height: 20%; } }\n\n        @keyframes oslHeartBurst {\n          0% { transform: scale(0.3); opacity: 0; }\n          35% { transform: scale(1.25); opacity: 1; }\n          70% { transform: scale(0.95); opacity: 1; }\n          100% { transform: scale(1.4); opacity: 0; }\n        }\n        #shutterscape-mobile-oilstain .osl-heart-burst {\n          animation: oslHeartBurst 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n        }\n\n        @media (max-width: 1023px) {\n          header[aria-label=\"Global Viewfinder Navigation\"] {\n            display: none !important;\n          }\n        }\n\n        #shutterscape-mobile-oilstain {\n          background-color: #ECEBE6;\n          color: #111111;\n          -webkit-overflow-scrolling: touch;\n        }\n        #shutterscape-mobile-oilstain .osl-top-capsule {\n          padding: 6px 14px !important;\n        }\n        #shutterscape-mobile-oilstain .osl-pad-sm { padding: 12px 16px !important; }\n        #shutterscape-mobile-oilstain .osl-pad-md { padding: 20px 18px !important; }\n        #shutterscape-mobile-oilstain .osl-pad-lg { padding: 30px 20px !important; }\n        #shutterscape-mobile-oilstain .osl-btn-pill { padding: 7px 12px !important; }\n        #shutterscape-mobile-oilstain .osl-bar-btn {\n          padding: 16px 20px !important;\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          width: 100%;\n          font-family: var(--font-space-mono), monospace;\n          font-size: 10.5px;\n          font-weight: 700;\n          letter-spacing: 0.16em;\n          text-transform: uppercase;\n          cursor: pointer;\n          transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;\n        }\n        #shutterscape-mobile-oilstain .osl-bento-cell {\n          padding: 20px 8px !important;\n          border-top: 1px solid rgba(17, 17, 17, 0.15);\n          border-bottom: 1px solid rgba(17, 17, 17, 0.15);\n          border-right: 1px solid rgba(17, 17, 17, 0.15);\n          display: flex;\n          flex-direction: column;\n          align-items: center;\n          justify-content: center;\n          gap: 5px;\n          background: #ECEBE6;\n          cursor: pointer;\n          transition: background 0.2s ease, color 0.2s ease;\n        }\n        #shutterscape-mobile-oilstain .osl-bento-cell.active-lab,\n        #shutterscape-mobile-oilstain .osl-bento-cell:active {\n          background: #111111;\n          color: #ECEBE6;\n        }\n        #shutterscape-mobile-oilstain .osl-chapter-pill {\n          padding: 13px 14px !important;\n          font-family: var(--font-space-mono), monospace;\n          font-size: 9.5px;\n          font-weight: 700;\n          letter-spacing: 0.14em;\n          text-transform: uppercase;\n          white-space: nowrap;\n          border-right: 1px solid rgba(17, 17, 17, 0.12);\n          cursor: pointer;\n          transition: all 0.2s ease;\n        }\n        #shutterscape-mobile-oilstain .osl-input-line {\n          width: 100%;\n          padding: 12px 0 !important;\n          border: none;\n          border-bottom: 1px solid rgba(17, 17, 17, 0.25);\n          background: transparent;\n          font-family: var(--font-space-mono), monospace;\n          font-size: 11px;\n          letter-spacing: 0.12em;\n          color: #111111;\n          outline: none;\n        }\n        #shutterscape-mobile-oilstain .osl-input-line:focus {\n          border-bottom-color: #D92B2B;\n        }\n        #shutterscape-mobile-oilstain .osl-input-line::placeholder {\n          color: rgba(17, 17, 17, 0.55);\n          text-transform: uppercase;\n        }\n        #shutterscape-mobile-oilstain .handmade-fountain-pen {\n          font-family: 'Nothing You Could Do', cursive !important;\n          font-weight: 400;\n          color: #1D1C1A;\n        }\n        #shutterscape-mobile-oilstain .handmade-signature-pen {\n          font-family: 'Reenie Beanie', cursive !important;\n          font-weight: 400;\n          color: #141311;\n        }\n        @keyframes oslLetterReveal {\n          0% {\n            opacity: 0;\n            transform: translate3d(0, 32px, 0) scale(0.86);\n          }\n          100% {\n            opacity: 1;\n            transform: translate3d(0, 0, 0) scale(1);\n          }\n        }\n        #shutterscape-mobile-oilstain .osl-letter-char {\n          display: inline-block;\n          opacity: 0;\n          transform: translate3d(0, 32px, 0) scale(0.86);\n          animation: oslLetterReveal 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n          will-change: transform, opacity;\n        }\n        @keyframes oslFadeDown {\n          0% { opacity: 0; transform: translate3d(0, -10px, 0); }\n          100% { opacity: 1; transform: translate3d(0, 0, 0); }\n        }\n        #shutterscape-mobile-oilstain .osl-hero-badge {\n          opacity: 0;\n          animation: oslFadeDown 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.05s forwards;\n        }\n        @keyframes oslRuleExpand {\n          0% { transform: scaleX(0); opacity: 0; }\n          100% { transform: scaleX(1); opacity: 1; }\n        }\n        #shutterscape-mobile-oilstain .osl-hero-rule {\n          transform: scaleX(0);\n          animation: oslRuleExpand 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.02s forwards;\n          transform-origin: center;\n        }\n        @keyframes oslSubtitleReveal {\n          0% { opacity: 0; transform: translate3d(0, 12px, 0); }\n          100% { opacity: 1; transform: translate3d(0, 0, 0); }\n        }\n        #shutterscape-mobile-oilstain .osl-hero-subtitle {\n          opacity: 0;\n          animation: oslSubtitleReveal 0.75s cubic-bezier(0.16, 1, 0.3, 1) 1.15s forwards;\n        }\n        @keyframes oslTaglineReveal {\n          0% { opacity: 0; transform: translate3d(0, 14px, 0); }\n          100% { opacity: 1; transform: translate3d(0, 0, 0); }\n        }\n        #shutterscape-mobile-oilstain .osl-hero-tagline {\n          opacity: 0;\n          animation: oslTaglineReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.35s forwards;\n        }\n      </style><div style=\"background-color:rgba(12, 12, 16, 0.2);backdrop-filter:blur(12px) saturate(140%);-webkit-backdrop-filter:blur(12px) saturate(140%);border-color:rgba(255, 255, 255, 0.15);transform:translate3d(-50%, 0, 0)\" class=\"osl-top-capsule fixed top-3 left-1/2 z-[9980] w-max max-w-[94vw] rounded-full border shadow-[0_8px_24px_rgba(0,0,0,0.28)] transition-colors duration-300 flex items-center justify-center gap-2 sm:gap-2.5 pointer-events-auto select-none\"><button type=\"button\" class=\"flex items-center cursor-pointer shrink-0\"><div style=\"width:90px;height:24px\" class=\"relative shrink-0\"><img alt=\"ShutterScape Logo\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain object-left\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/shutterscape-brand-white.png\"/></div></button><span class=\"h-3.5 w-[1px] bg-white/20 shrink-0\"></span><div class=\"flex items-center gap-2 shrink-0\"><button type=\"button\" style=\"padding:4.5px 10px\" class=\