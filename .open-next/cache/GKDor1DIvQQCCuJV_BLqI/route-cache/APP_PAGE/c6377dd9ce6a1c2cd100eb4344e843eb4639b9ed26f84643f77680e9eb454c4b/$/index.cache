-full h-full object-cover saturate-[1.16] transition-transform duration-500 group-hover:scale-105\" loading=\"lazy\" decoding=\"async\"/><div class=\"absolute inset-x-0 bottom-0 p-2.5 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"><span class=\"block font-mono text-[7px] tracking-[0.16em] uppercase text-[#FFE066] font-bold truncate\">PORTRAITURE</span><span class=\"block font-serif text-xs text-white leading-tight truncate\">Studio Xenon Strobe</span></div></div></div><div style=\"width:172px;height:230px;padding:6px;will-change:transform, opacity\" class=\"absolute bg-white rounded-2xl shadow-[0_18px_40px_rgba(0,0,0,0.16)] border border-black/10 cursor-pointer hover:border-[#D4A843] transition-colors group\"><div class=\"relative w-full h-full rounded-xl overflow-hidden bg-[#111111]\"><img src=\"/api/media/6ade54effadbce637226b636\" alt=\"Cantilever Shadows\" class=\"w-full h-full object-cover saturate-[1.16] transition-transform duration-500 group-hover:scale-105\" loading=\"lazy\" decoding=\"async\"/><div class=\"absolute inset-x-0 bottom-0 p-2.5 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"><span class=\"block font-mono text-[7px] tracking-[0.16em] uppercase text-[#FFE066] font-bold truncate\">ARCHITECTURE</span><span class=\"block font-serif text-xs text-white leading-tight truncate\">Cantilever Shadows</span></div></div></div><div style=\"width:172px;height:230px;padding:6px;will-change:transform, opacity\" class=\"absolute bg-white rounded-2xl shadow-[0_18px_40px_rgba(0,0,0,0.16)] border border-black/10 cursor-pointer hover:border-[#D4A843] transition-colors group\"><div class=\"relative w-full h-full rounded-xl overflow-hidden bg-[#111111]\"><img src=\"/api/media/6ade56029d67f6006e3db91a\" alt=\"Lens Flare Dispersion\" class=\"w-full h-full object-cover saturate-[1.16] transition-transform duration-500 group-hover:scale-105\" loading=\"lazy\" decoding=\"async\"/><div class=\"absolute inset-x-0 bottom-0 p-2.5 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"><span class=\"block font-mono text-[7px] tracking-[0.16em] uppercase text-[#FFE066] font-bold truncate\">EXPERIMENTAL</span><span class=\"block font-serif text-xs text-white leading-tight truncate\">Lens Flare Dispersion</span></div></div></div></div></div></div></div></div></section><section id=\"desktop-light-about-section\" class=\"relative z-20 w-full bg-[#FAF9F5] text-[#111111] border-t border-black/15\"><div style=\"height:290px\" class=\"relative w-full bg-[#111111] flex items-center justify-center overflow-hidden\"><img src=\"/images/gcu-campus-sketch.jpg\" alt=\"About ShutterScape\" class=\"absolute inset-0 w-full h-full object-cover opacity-65\" loading=\"lazy\" decoding=\"async\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/40\"></div><div class=\"relative z-10 text-center px-4\"><span class=\"font-mono text-[10px] tracking-[0.28em] uppercase text-[#D4A843] font-bold block mb-1.5\">GIRIJANANDA CHOWDHURY UNIVERSITY</span><h2 class=\"font-heading font-black text-4xl lg:text-5xl tracking-[0.06em] uppercase text-white\">ABOUT US</h2></div></div><div class=\"w-full overflow-x-auto no-scrollbar bg-[#ECEBE6] border-y border-black/15 flex items-center justify-center\"><div class=\"flex items-center\"><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#111111] text-white\"><span class=\"text-[#D4A843] font-bold\">01</span><span>ORIGINS</span></button><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#ECEBE6] text-[#111111]/70 hover:text-[#111111]\"><span class=\"opacity-45\">02</span><span>THE TEACHERS</span></button><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#ECEBE6] text-[#111111]/70 hover:text-[#111111]\"><span class=\"opacity-45\">03</span><span>BEHIND THE LENS</span></button><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#ECEBE6] text-[#111111]/70 hover:text-[#111111]\"><span class=\"opacity-45\">04</span><span>CORE MEMBERS</span></button><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#ECEBE6] text-[#111111]/70 hover:text-[#111111]\"><span class=\"opacity-45\">05</span><span>WHERE IT ALL STARTED</span></button><button type=\"button\" class=\"osl-chapter-pill shrink-0 flex items-center gap-2 bg-[#ECEBE6] text-[#111111]/70 hover:text-[#111111]\"><span class=\"opacity-45\">06</span><span>CARRYING IT FORWARD</span></button></div></div><div style=\"max-width:1280px;margin:0 auto;padding:52px 32px 68px\"><div style=\"display:flex;flex-direction:column;gap:32px\"><div class=\"grid grid-cols-12 gap-10 items-center\"><div class=\"col-span-7\" style=\"display:flex;flex-direction:column;gap:14px\"><div class=\"flex items-center gap-3\"><h3 class=\"font-heading font-black text-4xl uppercase tracking-[-0.03em] text-[#111111]\">STORYTELLERS</h3><span style=\"padding:4px 12px\" class=\"rounded-full bg-[#111111] text-[#FFE066] font-mono text-[9.5px] font-bold uppercase tracking-[0.18em]\">CHAPTER 01 // ORIGINS</span></div><p class=\"font-serif text-[21px] leading-[1.65] text-[#111111] font-normal\">Born at<!-- --> <span style=\"padding:2px 8px\" class=\"inline-block rounded font-heading font-bold text-[15px] uppercase tracking-tight transition-all duration-700 bg-transparent text-[#111111]\">Girijananda Chowdhury University</span> <!-- -->in Assam,<!-- --> <span class=\"italic font-semibold underline decoration-[#D92B2B] decoration-wavy decoration-1 underline-offset-4\">ShutterScape</span> <!-- -->is our unmedicated<!-- --> <span style=\"padding:2px 8px\" class=\"inline-block rounded font-mono text-[13px] font-bold uppercase tracking-wider transition-all duration-700 delay-150 bg-transparent text-[#111111]\">Visual Archive</span> <!-- -->— a pure manifesto of<!-- --> <span class=\"border-b-2 border-dashed border-[#0F766E] font-semibold text-[#0F766E]\">analog optics</span>,<!-- --> <span class=\"border-b-2 border-dashed border-[#D4A843] font-semibold\">street documentary</span>, and creative excess.</p></div><div style=\"padding:20px 22px;display:flex;flex-direction:column;gap:14px\" class=\"col-span-5 rounded-2xl bg-white border border-black/10 shadow-[0_12px_32px_rgba(0,0,0,0.05)]\"><div class=\"flex items-center justify-between border-b border-black/10 pb-2.5 font-mono text-[9px] uppercase tracking-[0.2em]\"><span class=\"font-bold text-[#D92B2B]\">★ THE SHUTTERSCAPE CREDO</span><span class=\"text-black/45 font-bold\">EST. 2023 · ASSAM</span></div><div class=\"grid grid-cols-3 gap-3 text-center\"><div style=\"padding:12px 8px\" class=\"rounded-xl bg-[#FAF9F5] border border-black/8\"><span class=\"font-mono text-[8px] font-bold uppercase text-black/45 block\">01 // EYE</span><span class=\"font-heading font-black text-xs uppercase text-[#111111] mt-1 block\">OBSERVE</span></div><div style=\"padding:12px 8px\" class=\"rounded-xl bg-[#FAF9F5] border border-black/8\"><span class=\"font-mono text-[8px] font-bold uppercase text-black/45 block\">02 // SHUTTER</span><span class=\"font-heading font-black text-xs uppercase text-[#111111] mt-1 block\">CAPTURE</span></div><div style=\"padding:12px 8px\" class=\"rounded-xl bg-[#FAF9F5] border border-black/8\"><span class=\"font-mono text-[8px] font-bold uppercase text-black/45 block\">03 // PRINT</span><span class=\"font-heading font-black text-xs uppercase text-[#111111] mt-1 block\">ARCHIVE</span></div></div></div></div><div style=\"padding:28px 32px;height:465px\" class=\"relative w-full overflow-hidden grid grid-cols-12 gap-7 items-center border border-black/12 bg-white rounded-3xl cursor-pointer shadow-[0_16px_44px_rgba(0,0,0,0.05)]\"><div style=\"padding:18px\" class=\"col-span-3 h-[400px] flex flex-col justify-between bg-[#FAF9F5] border border-black/10 rounded-2xl select-none text-left font-mono\"><div class=\"flex items-center justify-between text-[8.5px] tracking-[0.18em] uppercase text-black/50 pb-2.5 border-b border-black/10\"><span>PLATE DOSSIER</span><span class=\"text-[#D92B2B] font-bold\">PLATE 0<!-- -->1<!-- -->A</span></div><div style=\"display:flex;flex-direction:column;gap:12px;margin:auto 0\"><div><span class=\"text-[8px] tracking-[0.18em] uppercase text-black/40 block\">ACTIVE EXHIBITION PLATE</span><h4 style=\"margin-top:4px\" class=\"font-serif text-xl text-[#111111] font-normal leading-snug line-clamp-2\">Monsoon Moments</h4></div><div class=\"grid grid-cols-2 gap-2\"><div style=\"padding:9px 10px\" class=\"rounded-xl bg-white border border-black/8\"><span class=\"text-[7px] text-black/40 uppercase block\">FILM STOCK</span><span class=\"text-[9.5px] font-bold text-[#111111] mt-0.5 block truncate\">KODAK 400TX</span></div><div style=\"padding:9px 10px\" class=\"rounded-xl bg-white border border-black/8\"><span class=\"text-[7px] text-black/40 uppercase block\">OPTICS</span><span class=\"text-[9.5px] font-bold text-[#111111] mt-0.5 block truncate\">35MM · F/1.4</span></div><div style=\"padding:9px 10px\" class=\"rounded-xl bg-white border border-black/8\"><span class=\"text-[7px] text-black/40 uppercase block\">PROCESS</span><span class=\"text-[9.5px] font-bold text-[#0F766E] mt-0.5 block truncate\">C-41 / D-76</span></div><div style=\"padding:9px 10px\" class=\"rounded-xl bg-white border border-black/8\"><span class=\"text-[7px] text-black/40 uppercase block\">ARCHIVE LAB</span><span class=\"text-[9.5px] font-bold text-[#D92B2B] mt-0.5 block truncate\">GCU AZARA</span></div></div><p class=\"font-sans text-[11px] text-black/60 leading-relaxed line-clamp-2\">Captured and archived by GCU student storytellers during campus and Brahmaputra field expeditions.</p></div><div class=\"pt-2.5 border-t border-black/10 text-[8.5px] tracking-wider uppercase text-black/55 flex items-center justify-between\"><span>GCU ARCHIVE VAULT</span><button type=\"button\" class=\"text-[#111111] hover:text-[#D92B2B] font-bold cursor-pointer transition-colors\">NEXT PLATE →</button></div></div><div class=\"col-span-6 relative h-[400px] w-full bg-white flex items-center justify-center overflow-hidden\"><div style=\"opacity:1;width:300px;height:375px;padding:10px;transform:scale(1) rotate(-1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade74822b808e482f8eb5d7\" alt=\"Monsoon Moments\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:460px;height:345px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade79fcf52c3c4d0cca9b26\" alt=\"Vintage Camera — Product Study\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:300px;height:375px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade7b95927760001b6fed1b\" alt=\"The Ride — Best Alumni Photograph\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:460px;height:345px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade7bfe927760001b6fed1c\" alt=\"A Peaceful Evening on Campus\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:300px;height:375px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade7c66d43c2f957e160ddd\" alt=\"A Cinematic Campus View\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:460px;height:345px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade7dd4c134b1867ef53687\" alt=\"Golden Hour in the Classroom\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:300px;height:375px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade723381e180affa193019\" alt=\"Beyond the Classroom — Shutterscape Photography Session\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div><div style=\"opacity:0;width:300px;height:375px;padding:10px;transform:scale(0.96) rotate(1deg)\" class=\"absolute bg-white rounded-2xl shadow-[0_24px_55px_rgba(0,0,0,0.18)] border border-black/12 pointer-events-none transition-all duration-200\"><img src=\"/api/media/6ade724a83870de2ac5f3cf2\" alt=\"World Photography Day Exhibition 2026\" class=\"w-full h-full object-cover rounded-xl saturate-[1.15] contrast-[1.04]\" loading=\"lazy\" decoding=\"async\"/></div></div><div style=\"padding:18px\" class=\"col-span-3 h-[400px] flex flex-col justify-between bg-[#FAF9F5] border border-black/10 rounded-2xl select-none text-left font-mono\"><div class=\"flex items-center justify-between text-[8.5px] tracking-[0.18em] uppercase text-black/50 pb-2.5 border-b border-black/10\"><span>CONTACT SHEET</span><span class=\"text-[#D92B2B] font-bold\">0<!-- -->1<!-- --> / 0<!-- -->8</span></div><div class=\"grid grid-cols-2 gap-2 my-auto py-2\"><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-[#D92B2B] scale-[1.03] shadow-sm\"><img src=\"/api/media/6ade74822b808e482f8eb5d7\" alt=\"Monsoon Moments\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->1<!-- -->A</span></button><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-transparent opacity-65 hover:opacity-100\"><img src=\"/api/media/6ade79fcf52c3c4d0cca9b26\" alt=\"Vintage Camera — Product Study\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->2<!-- -->A</span></button><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-transparent opacity-65 hover:opacity-100\"><img src=\"/api/media/6ade7b95927760001b6fed1b\" alt=\"The Ride — Best Alumni Photograph\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->3<!-- -->A</span></button><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-transparent opacity-65 hover:opacity-100\"><img src=\"/api/media/6ade7bfe927760001b6fed1c\" alt=\"A Peaceful Evening on Campus\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->4<!-- -->A</span></button><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-transparent opacity-65 hover:opacity-100\"><img src=\"/api/media/6ade7c66d43c2f957e160ddd\" alt=\"A Cinematic Campus View\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->5<!-- -->A</span></button><button type=\"button\" class=\"group relative aspect-[4/3] rounded-lg overflow-hidden border-2 cursor-pointer transition-all border-transparent opacity-65 hover:opacity-100\"><img src=\"/api/media/6ade7dd4c134b1867ef53687\" alt=\"Golden Hour in the Classroom\" class=\"w-full h-full object-cover\"/><span class=\"absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/75 text-[7px] text-[#FFE066] font-bold\">0<!-- -->6<!-- -->A</span></button></div><div class=\"pt-2.5 border-t border-black/10 text-[8.5px] tracking-wider uppercase text-black/55 flex items-center justify-between\"><span>SELECT ANY PLATE</span><span class=\"text-[#111111] font-bold\">35MM LOUPE ↗</span></div></div></div><div class=\"grid grid-cols-12 gap-10 items-center\"><div class=\"col-span-7\"><span style=\"margin-bottom:8px\" class=\"font-mono text-[11px] tracking-[0.22em] uppercase text-[#D92B2B] font-bold block\">DOUBLE VISION // <!-- -->Monsoon Moments</span><p class=\"font-serif text-[20px] text-[#111111]/85 leading-[1.65]\">ShutterScape was created for students who love to<!-- --> <span class=\"font-semibold text-[#111111] underline decoration-[#D4A843] decoration-2 underline-offset-4\">observe, capture, and tell stories</span> <!-- -->through photographs. Whether you shoot on a<!-- --> <span style=\"padding:2px 7px\" class=\"rounded bg-[#FFF3BF] text-[#8C6D1F] font-mono text-[11.5px] font-bold\">35mm SLR</span>, a<!-- --> <span style=\"padding:2px 7px\" class=\"rounded bg-[#E7F5FF] text-[#1864AB] font-mono text-[11.5px] font-bold\">mirrorless rig</span>, or your<!-- --> <span style=\"padding:2px 7px\" class=\"rounded bg-[#EBFBEE] text-[#2B8A3E] font-mono text-[11.5px] font-bold\">phone</span> <!-- -->—<!-- --> <span class=\"italic font-semibold text-[#D92B2B]\">there is a place for you in our darkroom.</span></p></div><div style=\"padding:20px 24px\" class=\"col-span-5 rounded-2xl bg-[#111111] text-white flex items-center justify-between gap-4 shadow-lg\"><div class=\"space-y-1\"><span class=\"font-mono text-[8.5px] tracking-[0.2em] uppercase text-[#FFE066] font-bold block\">● OPEN TO ALL GCU STUDENTS</span><h4 class=\"font-heading font-bold text-base text-white tracking-tight\">Step Into Our Darkroom Roster</h4><p class=\"font-sans text-[11px] text-white/65\">SLR · Mirrorless · Smartphone · Strobe Lab</p></div><button type=\"button\" style=\"padding:10px 18px\" class=\"rounded-full bg-[#FFE066] hover:bg-white text-[#111111] font-mono text-[9.5px] font-bold uppercase tracking-wider shrink-0 cursor-pointer transition-colors\">JOIN US ↗</button></div></div></div></div></section><section id=\"desktop-chronology-matrix\" class=\"relative z-20 w-full bg-[#070709] text-white border-t border-white/10 overflow-hidden\"><div class=\"pointer-events-none absolute inset-0 z-0 opacity-25\" style=\"background:radial-gradient(ellipse 65% 45% at 50% 25%, rgba(239, 68, 68, 0.22) 0%, transparent 75%)\"></div><div style=\"padding:48px 24px 16px;max-width:680px;margin:0 auto\" class=\"relative z-10 flex flex-col items-center justify-center text-center gap-2 w-full\"><h2 class=\"font-script text-6xl font-bold tracking-normal leading-[0.9]\"><span class=\"text-white drop-shadow-sm\">Frames in </span><span class=\"text-[#EF4444] drop-shadow-[0_0_35px_rgba(239,68,68,0.45)]\">Motion</span></h2><p class=\"font-sans text-sm text-gray-400 font-medium tracking-wide\">Moments in motion — from the club and its members.</p><div class=\"pt-1\"><button type=\"button\" class=\"group inlin