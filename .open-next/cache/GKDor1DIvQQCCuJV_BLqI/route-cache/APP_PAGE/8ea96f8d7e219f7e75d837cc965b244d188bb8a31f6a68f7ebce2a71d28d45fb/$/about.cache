ext/image?url=%2Fimages%2Fgcu-campus-sketch.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fgcu-campus-sketch.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"absolute inset-0 pointer-events-none\" style=\"background:radial-gradient(ellipse at 50% 50%, rgba(5,5,5,0.40) 0%, rgba(5,5,5,0.88) 100%)\"></div></div><div class=\"hero-scroll-guide absolute bottom-6 sm:bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 pointer-events-none select-none will-change-transform\"><div class=\"w-5 h-8 sm:w-6 sm:h-9 rounded-full border border-white/35 flex justify-center pt-1.5 shadow-lg bg-black/40 backdrop-blur-xs\"><div class=\"w-1 h-2 sm:h-2.5 bg-[#D4A843] rounded-full animate-bounce\"></div></div><span class=\"font-mono text-[8.5px] sm:text-[9.5px] tracking-[0.3em] uppercase text-white/50 font-medium\">SCROLL TO DIVE</span></div><div class=\"absolute inset-0 z-10 flex flex-col items-center justify-center pointer-events-none px-4 overflow-hidden\"><div class=\"hero-massive-text flex flex-col items-center justify-center text-center select-none will-change-transform z-20\"><span class=\"hero-word-shutter font-heading text-5xl sm:text-7xl md:text-9xl lg:text-[11rem] xl:text-[13rem] font-black tracking-[-0.04em] text-white lowercase leading-[0.85] md:leading-[0.82] will-change-transform\">shutter</span><span class=\"hero-word-scape font-heading text-5xl sm:text-7xl md:text-9xl lg:text-[11rem] xl:text-[13rem] font-light tracking-[-0.02em] text-white/95 lowercase leading-[0.85] md:leading-[0.82] -mt-1 sm:-mt-3 md:-mt-5 will-change-transform\">scape<span class=\"text-[#D4A843]\">.</span></span></div><div class=\"hero-hidden-text absolute flex flex-col items-center text-center max-w-3xl px-4 sm:px-6 opacity-0 will-change-transform z-10\"><span class=\"font-mono text-[9px] sm:text-[11px] md:text-[13px] tracking-[0.45em] text-[#D4A843] uppercase font-bold mb-3 md:mb-4\">CHAPTER 01 // ORIGINS</span><h2 class=\"font-serif text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-light italic text-white mb-3 sm:mb-5 leading-tight\">More than just <br/><span class=\"text-[#D4A843] font-normal not-italic\">a camera club.</span></h2><div class=\"w-10 sm:w-14 h-[2px] bg-[#D4A843] mb-4 sm:mb-6\"></div><p class=\"font-body text-xs sm:text-base md:text-lg font-light leading-relaxed text-[#FAFAFA]/90 mb-2 sm:mb-3 max-w-2xl\">Shutterscape is the photography club of Girijananda Chowdhury University, created for students who love to observe, capture and tell stories through photographs.</p><p class=\"font-body text-[11px] sm:text-sm md:text-base font-light leading-relaxed text-[#FAFAFA]/70 max-w-2xl\">Whether you are a professional photographer or someone who simply loves clicking pictures on your phone —<!-- --> <span class=\"text-[#D4A843] font-medium\">there’s a place for you here.</span></p></div></div><div class=\"ch-2-mentors absolute inset-0 z-20 flex flex-col items-center justify-center px-4 sm:px-6 opacity-0 pointer-events-none will-change-transform\"><div class=\"text-center mb-5 sm:mb-8 md:mb-10\"><span class=\"font-mono text-[9px] sm:text-[10px] tracking-[0.4em] text-[#D4A843] uppercase mb-1 sm:mb-2 block font-semibold\">CHAPTER 02 // MENTORS</span><h2 class=\"font-serif text-2xl sm:text-4xl md:text-6xl uppercase tracking-widest text-white/30 leading-none\">The Teachers Who<!-- --> <span class=\"text-white font-normal\">Guide Us</span></h2></div><div class=\"flex flex-row justify-center items-start gap-6 sm:gap-12 md:gap-20 w-full max-w-4xl mx-auto pointer-events-auto\"><div class=\"w-[46%] sm:w-[42%] max-w-[260px] md:max-w-[290px]\"><div title=\"Click to know about Dr. Sangeeta Das\" style=\"--card-bg:#F5B700;--card-hover-bg:#00C7E6;--stripe-color:rgba(17, 24, 39, 0.22)\" class=\"popout-member-card group relative flex flex-col items-center cursor-pointer pointer-events-auto select-none w-full\"><div class=\"relative w-full aspect-[3/3.8] max-h-[175px] sm:max-h-[255px] md:max-h-[320px] flex items-end justify-center overflow-visible\"><div class=\"popout-backdrop absolute inset-x-0 bottom-0 h-[70%] group-hover:h-[76%] rounded-xl overflow-hidden transition-all duration-500 ease-out shadow-[0_20px_50px_rgba(0,0,0,0.65)]\"><div class=\"popout-stripes absolute -top-6 -left-6 w-24 h-24 sm:w-32 sm:h-32 opacity-75 group-hover:opacity-100 group-hover:rotate-12 group-hover:scale-110 transition-all duration-500 pointer-events-none\" style=\"background-image:repeating-linear-gradient(135deg, var(--stripe-color) 0px, var(--stripe-color) 5px, transparent 5px, transparent 11px)\"></div><div class=\"popout-stripes absolute -bottom-6 -right-6 w-24 h-24 sm:w-32 sm:h-32 opacity-50 group-hover:opacity-90 group-hover:-rotate-12 transition-all duration-500 pointer-events-none\" style=\"background-image:repeating-linear-gradient(135deg, var(--stripe-color) 0px, var(--stripe-color) 5px, transparent 5px, transparent 11px)\"></div><div class=\"absolute inset-0 bg-gradient-to-tr from-black/25 via-transparent to-white/15 pointer-events-none\"></div></div><div class=\"relative z-10 w-[82%] h-[98%] rounded-t-[42%] rounded-b-lg overflow-hidden shadow-[0_14px_34px_rgba(0,0,0,0.55)] border-b-0 transition-transform duration-500 ease-out group-hover:-translate-y-2.5 group-hover:scale-[1.04]\"><img alt=\"Dr. Sangeeta Das\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top grayscale contrast-115 group-hover:grayscale-0 group-hover:contrast-105 transition-all duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"360px\" srcSet=\"/_next/image?url=%2Fapi%2Fmedia%2F6ade6d69c495688122f1ccd0&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fapi%2Fmedia%2F6ade6d69c495688122f1ccd0&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fapi%2Fmedia%2F6ade6d69c495688122f1ccd0&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fapi%2Fmedia%2F6ade6d69c495688122f1ccd0&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fapi%2Fmedia%2F6ade6d69c495688122f1ccd0&amp;w=1