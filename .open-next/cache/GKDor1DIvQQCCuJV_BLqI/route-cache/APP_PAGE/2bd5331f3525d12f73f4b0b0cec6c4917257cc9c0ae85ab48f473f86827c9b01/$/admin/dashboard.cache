order-radius: 8px;\n          font-size: 12.5px;\n          font-weight: 600;\n          color: #5A6A85;\n          background: transparent;\n          border: none;\n          cursor: pointer;\n          transition: all 0.18s ease;\n        }\n        #cms-enterprise-root .cms-nav-btn:hover {\n          background-color: #F6F9FC;\n          color: #5D87FF;\n        }\n        #cms-enterprise-root .cms-nav-btn.active {\n          background-color: #5D87FF;\n          color: #FFFFFF;\n          box-shadow: 0 4px 12px rgba(93, 135, 255, 0.25);\n        }\n        #cms-enterprise-root .cms-card {\n          background: #FFFFFF;\n          border-radius: 12px;\n          border: 1px solid #EAEFF4;\n          box-shadow: 0 2px 12px rgba(145, 158, 171, 0.05);\n          transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;\n          overflow: hidden;\n          display: flex;\n          flex-direction: column;\n        }\n        #cms-enterprise-root .cms-card:hover {\n          transform: translateY(-2px);\n          box-shadow: 0 8px 20px rgba(145, 158, 171, 0.1);\n          border-color: #D5E0EE;\n        }\n        #cms-enterprise-root .cms-card-body {\n          padding: 12px 14px !important;\n          display: flex;\n          flex-direction: column;\n          flex: 1;\n          justify-content: space-between;\n        }\n        #cms-enterprise-root .cms-kpi-card {\n          background: #FFFFFF;\n          border-radius: 12px;\n          border: 1px solid #EAEFF4;\n          padding: 12px 16px !important;\n          box-shadow: 0 2px 10px rgba(145, 158, 171, 0.04);\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          gap: 12px;\n        }\n        #cms-enterprise-root .cms-primary-btn {\n          background: #5D87FF;\n          color: #FFFFFF;\n          padding: 7px 14px !important;\n          border-radius: 8px;\n          font-size: 12px;\n          font-weight: 600;\n          border: none;\n          display: inline-flex;\n          align-items: center;\n          gap: 6px;\n          box-shadow: 0 3px 10px rgba(93, 135, 255, 0.25);\n          cursor: pointer;\n          transition: all 0.18s ease;\n        }\n        #cms-enterprise-root .cms-primary-btn:hover {\n          background: #4570EA;\n          box-shadow: 0 4px 14px rgba(93, 135, 255, 0.35);\n        }\n        #cms-enterprise-root .cms-action-edit {\n          padding: 5px 10px !important;\n          border-radius: 6px;\n          border: 1px solid #DFE5EF;\n          background: #FFFFFF;\n          color: #2A3547;\n          font-size: 11.5px;\n          font-weight: 600;\n          display: inline-flex;\n          align-items: center;\n          justify-content: center;\n          gap: 5px;\n          cursor: pointer;\n          transition: all 0.16s ease;\n        }\n        #cms-enterprise-root .cms-action-edit:hover {\n          background: #ECF2FF;\n          border-color: #5D87FF;\n          color: #5D87FF;\n        }\n        #cms-enterprise-root .cms-action-delete {\n          padding: 5px 10px !important;\n          border-radius: 6px;\n          border: 1px solid #FDEDE8;\n          background: #FDEDE8;\n          color: #FA896B;\n          font-size: 11.5px;\n          font-weight: 600;\n          display: inline-flex;\n          align-items: center;\n          justify-content: center;\n          gap: 5px;\n          cursor: pointer;\n          transition: all 0.16s ease;\n        }\n        #cms-enterprise-root .cms-action-delete:hover {\n          background: #FA896B;\n          border-color: #FA896B;\n          color: #FFFFFF;\n        }\n        #cms-enterprise-root .cms-filter-pill {\n          padding: 5px 12px !important;\n          border-radius: 7px;\n          font-size: 11.5px;\n          font-weight: 600;\n          border: none;\n          cursor: pointer;\n          transition: all 0.16s ease;\n          white-space: nowrap;\n        }\n       