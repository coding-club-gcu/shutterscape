# MongoDB Atlas Cloud Database Connection String (M0 Free Tier)
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/shutterscape?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key (Generate random 32+ char string)
AUTH_SECRET=shutterscape-super-secure-darkroom-vault-secret-key-2026

# Initial Emergency Admin Credentials (used if MongoDB URI is not yet configured)
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=ShutterScape2026!

# ============================================================
# OPTION 1: CLOUDINARY MEDIA STORAGE (100% Free, NO Credit Card)
# 25 GB of storage & bandwidth / month, global photography CDN
# Found on your Cloudinary dashboard overview
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# OPTION 2: CLOUDFLARE R2 OBJECT STORAGE (10GB Free Tier)
# ============================================================
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shutterscape-media
R2_PUBLIC_URL=
